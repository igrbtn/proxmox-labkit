# Copy to .env and fill in. NEVER commit real values.

# Any Proxmox cluster node reachable over SSH with a key.
PVE_SSH=root@10.0.0.11

# Lab admin / domain admin / DSRM password. Substituted for the __LAB_PW__
# token when guest scripts are generated - no password literals on disk.
# Allowed: letters, digits, @ # % ^ * ( ) - _ + = . ,   (no quotes ; < > & backtick)
LAB_PW=

# Media on the Proxmox nodes (lib/prepare-media.sh downloads these).
WIN_ISO=ws2025-eval.iso
VIRTIO_ISO=virtio-win.iso
